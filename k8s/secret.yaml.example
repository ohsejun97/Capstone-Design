# 복사해서 secret.yaml로 만든 뒤 값을 채운다. secret.yaml은 .gitignore 대상.
#   cp k8s/secret.yaml.example k8s/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: fusiondti-secrets
  namespace: fusiondti
type: Opaque
stringData:
  POSTGRES_PASSWORD: "change-me"
  # 선택: agent/llm.py의 LLM 엔티티 추출 경로에 필요. 없으면 규칙 경로로 폴백한다.
  ANTHROPIC_API_KEY: ""
